# KLAY K — variáveis de ambiente sobrescritíveis no build.
#
# O app lê via --dart-define (não usa arquivo .env em runtime). Os valores
# públicos padrão já estão embutidos em lib/services/app_config.dart; use
# este arquivo apenas como referência dos nomes aceitos. NUNCA coloque aqui
# segredos (service_role, LiveKit API secret, etc.).

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_PROJECT_REF=