  Widget _buildControlsBar(bool keyboard) {
    if (keyboard) return const SizedBox.shrink();
    return Positioned(bottom: 16, left: 16, right: 16, child: AnimatedOpacity(opacity: _showControls ? 1.0 : 0.0, duration: const Duration(milliseconds: 300), child: Row(children: [// Esquerda: curtida + presentes
      _buildSideButton(icon: Icons.favorite_rounded, label: 'Curtir', onTap: _toggleLike, active: _liked),
