  Widget _buildRecapOverlay() {
    final l10n = AppLocalizations.of(context)!;
    final duration = DateTime.now().difference(_joinedAt);
    final minutes = duration.inMinutes;
    final h = minutes ~/ 60;
    final m = minutes % 60;
    final timeLabel = h > 0 ? l10n.recapDurationHM(h, m.toString().padLeft(2, '0')) : l10n.recapDurationM(m);
    return Positioned.fill(child: Container(color: Colors.black.withValues(alpha: 0.82), alignment: Alignment.center, child: SingleChildScrollView(padding: const EdgeInsets.symmetric(horizontal: 28, vertical: 24), child: Column(mainAxisSize: MainAxisSize.min, children: [Container(padding: const EdgeInsets.all(18), decoration: BoxDecoration(color: _kAccent.withValues(alpha: 0.2), shape: BoxShape.circle), child: const Icon(Icons.check_circle_rounded, color: Color(0xFF22C55E), size: 44)), const SizedBox(height: 18), Text(l10n.liveEnded, style: const TextStyle(color: Colors.white, fontSize: 22, fontWeight: FontWeight.w900)), const SizedBox(height: 6), Text(_live.title, textAlign: TextAlign.center, maxLines: 2, overflow: TextOverflow.ellipsis, style: const TextStyle(color: Colors.white70)), const SizedBox(height: 20), _recapStat(l10n.recapDurationLabel, timeLabel), const SizedBox(height: 10), _recapStat(l10n.recapPeakLabel, '$_peakViewers'), if (widget.isGameLive) ...[const SizedBox(height: 10), _recapStat(l10n.recapGameLabel, _live.gameName ?? '—')], const SizedBox(height: 24), FilledButton(onPressed: () { setState(() => _recapDismissed = true); Navigator.of(context).pop(true); }, style: FilledButton.styleFrom(backgroundColor: _kAccent, minimumSize: const Size(220, 50), shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16))), child: Text(l10n.recapFinishLabel, style: const TextStyle(fontWeight: FontWeight.w800)))])));
  }

  Widget _recapStat(String label, String value) {
    return Container(width: double.infinity, padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12), decoration: BoxDecoration(color: Colors.white.withValues(alpha: 0.06), borderRadius: BorderRadius.circular(12)), child: Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [Text(label, style: const TextStyle(color: Colors.white54)), Text(value, style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w800, fontSize: 16))]));
  }

  // =========================================================================
  // MAIS OPÇÕES MENU
  // =========================================================================

  void _openMoreSheet() {
    final isStreamer = widget.role == LiveRole.streamer;
    final items = [
      if (!isStreamer) ...[
        KlayMoreItem(label: 'Denunciar', icon: Icons.flag_rounded, color: const Color(0xFFFFA53D), onTap: () { Navigator.of(context).pop(); }),
        KlayMoreItem(label: 'Bloquear', icon: Icons.block_rounded, color: Colors.white, onTap: () { Navigator.of(context).pop(); }),
      ],
      if (isStreamer) ...[
        KlayMoreItem(label: 'Configurações', icon: Icons.settings_rounded, color: Colors.white, onTap: () { Navigator.of(context).pop(); _openGameSettings(); }),
        KlayMoreItem(label: 'Moderadores', icon: Icons.shield_rounded, color: Colors.white, onTap: () { Navigator.of(context).pop(); }),
      ],
      KlayMoreItem(label: 'Informações', icon: Icons.info_rounded, color: Colors.white, onTap: () { Navigator.of(context).pop(); }),
      KlayMoreItem(label: 'Ocultar chat', icon: Icons.chat_bubble_outline_rounded, color: Colors.white, onTap: () { Navigator.of(context).pop(); setState(() => _chatOpen = false); }),
    ];
    if (widget.isGameLive && isStreamer) {
      items.add(KlayMoreItem(label: 'RTMP', icon: Icons.live_tv_rounded, color: Colors.white, onTap: () { Navigator.of(context).pop(); _startRtmpStream(); }));
    }
    KlayMoreSheet.show(context, items: items, toggles: [
      KlayMoreToggle(label: 'Efeitos de reação', value: !ExperienceSettings.instance.reduceAnimations, onChanged: (v) {}),
    ]);
  }

  // =========================================================================
  // BADGE AO VIVO
  // =========================================================================

  class _LiveBadge extends StatelessWidget {
    const _LiveBadge();
    @override
    Widget build(BuildContext context) {
      return Container(padding: const EdgeInsets.symmetric(horizontal: 9, vertical: 4), decoration: BoxDecoration(color: _kLiveRed, borderRadius: BorderRadius.circular(8), boxShadow: [BoxShadow(color: _kLiveRed.withValues(alpha: 0.25), blurRadius: 6)]), child: const Row(mainAxisSize: MainAxisSize.min, children: [Icon(Icons.circle, color: Colors.white, size: 8), SizedBox(width: 4), Text('AO VIVO', style: TextStyle(color: Colors.white, fontSize: 11, fontWeight: FontWeight.w800, letterSpacing: 0.5))]));
    }
  }
}

// =========================================================================
  final String label;
  final IconData? icon;
  final Color color;
  final VoidCallback? onTap;
  const KlayMoreItem({required this.label, this.icon, this.color = Colors.white, this.onTap});
}

class KlayMoreToggle {
  final String label;
  final bool value;
  final ValueChanged<bool> onChanged;
  const KlayMoreToggle({required this.label, required this.value, required this.onChanged});
}

class KlayMoreSheet {
  KlayMoreSheet._();
  static Future<void> show(BuildContext showContext, {required List<KlayMoreItem> items, List<KlayMoreToggle> toggles = const []}) {
    return showModalBottomSheet<void>(context: showContext, backgroundColor: const Color(0xFF141420), isScrollControlled: true, useSafeArea: true, shape: const RoundedRectangleBorder(borderRadius: BorderRadius.vertical(top: Radius.circular(22))), builder: (ctx) => StatefulBuilder(builder: (ctx, setSheetState) { return ConstrainedBox(constraints: BoxConstraints(maxHeight: MediaQuery.of(ctx).size.height * 0.86), child: SingleChildScrollView(padding: const EdgeInsets.fromLTRB(8, 10, 8, 14), child: Column(mainAxisSize: MainAxisSize.min, children: [Container(width: 40, height: 4, decoration: BoxDecoration(color: Colors.white24, borderRadius: BorderRadius.circular(2))), const SizedBox(height: 8), for (final item in items) _row(showContext, item), if (toggles.isNotEmpty) ...[const Divider(color: Color(0x14FFFFFF), height: 1), for (var i = 0; i < toggles.length; i++) SwitchListTile(dense: true, contentPadding: const EdgeInsets.symmetric(horizontal: 16), activeThumbColor: const Color(0xFF8B5CF6), activeTrackColor: const Color(0xFF8B5CF6).withValues(alpha: 0.35), title: Text(toggles[i].label, style: const TextStyle(color: Colors.white, fontSize: 15)), value: toggles[i].value, onChanged: (v) { setSheetState(() => toggles[i].value = v); toggles[i].onChanged(v); })]],))); }));
  }

  static Widget _row(BuildContext ctx, KlayMoreItem item) {
    return InkWell(onTap: () { Navigator.of(ctx).pop(); item.onTap?.call(); }, borderRadius: BorderRadius.circular(14), child: Padding(padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 14), child: Row(children: [if (item.icon != null) ...[Container(width: 36, height: 36, decoration: BoxDecoration(shape: BoxShape.circle, color: item.color.withValues(alpha: 0.14)), child: Icon(item.icon, color: item.color, size: 20)), const SizedBox(width: 14)], Expanded(child: Text(item.label, style: TextStyle(color: item.color, fontSize: 15, fontWeight: FontWeight.w600))), const Icon(Icons.chevron_right_rounded, color: Colors.white30, size: 20)],)]));
  }
}
