      _buildSideButton(icon: Icons.redeem_rounded, label: 'Presentes', onTap: _openGiftPicker),
      const SizedBox(width: 8),
      // Centro: câmera, mic, share (streamer) ou vídeo (viewer)
      if (widget.role == LiveRole.streamer) ...[
        _buildControlButton(icon: _camOn ? Icons.videocam_rounded : Icons.videocam_off_rounded, onTap: _toggleCamera),
        const SizedBox(width: 8),
        _buildControlButton(icon: _micOn ? Icons.mic_rounded : Icons.mic_off_rounded, onTap: _toggleMicrophone),
        const SizedBox(width: 8),
        if (widget.isGameLive) _buildControlButton(icon: _shareOn ? Icons.stop_screen_share_rounded : Icons.screen_share_rounded, onTap: _toggleScreenShare, active: _shareOn),
        if (widget.isGameLive) const SizedBox(width: 8),
        _buildControlButton(icon: Icons.call_end_rounded, onTap: _endLive, color: _kLiveRed),
      ] else ...[
        _buildControlButton(icon: Icons.flip_camera_android_rounded, onTap: _toggleViewerVideo),
        const SizedBox(width: 8),
        _buildControlButton(icon: _audioListenOn ? Icons.volume_up_rounded : Icons.volume_off_rounded, onTap: _toggleViewerAudio),
      ],
      const Spacer(),
      // Direita: chat, compartilhar, mais
      _buildSideButton(icon: Icons.chat_bubble_rounded, label: 'Chat', onTap: () => setState(() => _chatOpen = !_chatOpen), active: _chatOpen),
      const SizedBox(width: 8),
      _buildSideButton(icon: Icons.share_rounded, label: 'Compartilhar', onTap: _share),
      const SizedBox(width: 8),
      _buildSideButton(icon: Icons.settings_rounded, label: 'Config', onTap: () => Navigator.of(context).push(MaterialPageRoute(builder: (_) => const SizedBox.shrink()))),
    ],)),
  }

