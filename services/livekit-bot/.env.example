# KLAY K Bot - server-side environment configuration.
# Required (the bot refuses to start without them):
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Supabase (service role key enables full Realtime reads):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional / configurable:
OPENAI_API_KEY=
BOT_NAME=KLAY K Bot
BOT_TTS_PROVIDER=noop
BOT_TTS_MODEL=gpt-4o-mini-tts
BOT_TTS_VOICE=alloy
BOT_TTS_COOLDOWN_MS=4000
BOT_PUBLISH_AUDIO=false
BOT_MONITOR_ROOMS=
BOT_LIVE_POLL_MS=15000